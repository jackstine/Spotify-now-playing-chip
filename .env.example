# Copy to .env (gitignored) and fill in, then run ./build.sh (it bundles this file into the app).
# Alternatively place it at ~/.config/NowPlayingChip/.env

# Required for the "add to playlist" button.
# Create an app at https://developer.spotify.com/dashboard, add the redirect URI
# http://127.0.0.1:8888/callback, and paste its Client ID here.
# (No client secret is needed: the app uses PKCE. Do not add one.)
SPOTIFY_CLIENT_ID=

# Exact name of one of your playlists (case-insensitive) that tracks get added to.
SPOTIFY_PLAYLIST_NAME=

# Optional. Name of the Chrome profile (as shown in Chrome's profile menu) to open the Spotify
# login in and auto-click "Agree". Leave empty to use your default browser and click Agree yourself.
CHROME_PROFILE_NAME=
